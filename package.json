{
  "name": "server-manager",
  "productName": "Server Manager",
  "version": "1.3.2",
  "description": "Control an ARK: Survival Evolved server on a NAS over SSH",
  "main": "main.js",
  "author": "FJBC",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.fjbc.servermanager",
    "productName": "Server Manager",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "ark.js",
      "renderer/**",
      "build/icon.png",
      "build/tray-*.png",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Server-Manager-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Server Manager",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "paramtric-design-3",
        "repo": "Server-Manager",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paramtric-design-3/Server-Manager.git"
  }
}
